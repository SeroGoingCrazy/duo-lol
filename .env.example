# Copy to .env and fill in. .env is git-ignored.
# Dev key from https://developer.riotgames.com (expires every 24h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: Neon connection string. The collector, API and scripts use it instead of lol_duo.sqlite
# (an explicit --db or DUO_DB still wins). Copy existing data over once with data/to_postgres.py.
DATABASE_URL=
