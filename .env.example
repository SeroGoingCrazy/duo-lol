# Copy to .env and fill in. .env is git-ignored.
# Dev key from https://developer.riotgames.com (expires every 24h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: a Postgres connection string. The collector, API and scripts use it instead of lol_duo.sqlite
# (an explicit --db or DUO_DB still wins). Leave it empty for the usual setup: collection stays in SQLite and
# data/sync_site.py copies what the site needs to Neon (docs/deploy.md §2).
DATABASE_URL=
