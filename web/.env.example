# Copy to web/.env.local and fill in. .env.local is git-ignored.
# Login (PRD-v2 §3.1). Generate the secret with: npx auth secret
AUTH_SECRET=
# Discord app from https://discord.com/developers/applications, redirect URL
# http://localhost:3000/api/auth/callback/discord (and the production URL later)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Production Postgres; leave empty locally to use PGlite in web/.data/app
DATABASE_URL=
# Local demo only: shows a 测试登录 box so you can log in without Discord. Never set in production.
AUTH_DEV_LOGIN=1
